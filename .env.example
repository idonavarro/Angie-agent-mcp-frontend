PORT=8080
MCP_AUTH_TOKEN=generate-a-long-random-string
# Angie UI has no auth header field — put token in Server URL: https://HOST/mcp?token=THIS_VALUE
MCP_AUTH_MODE=bearer_or_query
MCP_ENDPOINT_PATH=/mcp
MCP_ENDPOINT_ALIASES=/api
ALLOW_INSECURE_HTTP=false
ALLOW_PRIVATE_URLS=false
NODE_ENV=production
# Log all MCP HTTP in/out (sanitized). Also auto-on when LOG_LEVEL=debug
MCP_LOG_TRAFFIC=false
LOG_LEVEL=info
# Upload layout scan screenshots to https://agent-img.com (Bearer aih_… token)
AGENT_IMG_TOKEN=
